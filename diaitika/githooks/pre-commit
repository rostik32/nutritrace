#!/usr/bin/env bash
# Block commits that contain secrets. Enable with: git config core.hooksPath diaitika/githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks) — refusing to commit." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner
